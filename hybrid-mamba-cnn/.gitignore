# ============================================
# Hybrid Mamba-CNN Project .gitignore
# ============================================

# -------------------- Python --------------------
# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class
*.pyo
*.pyd

# C extensions
*.so

# Distribution / packaging
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# PyInstaller
*.manifest
*.spec

# -------------------- Virtual Environments --------------------
venv/
.env/
.venv/
env/
ENV/
mamba-research/

# -------------------- Jupyter Notebooks --------------------
.ipynb_checkpoints/
*.ipynb_meta/

# -------------------- IDE / Editor --------------------
# VS Code
.vscode/
*.code-workspace
!hybrid mamba.code-workspace

# PyCharm / IntelliJ
.idea/
*.iml

# Vim
*.swp
*.swo
*~

# Sublime Text
*.sublime-project
*.sublime-workspace

# Spyder
.spyderproject
.spyproject

# -------------------- Data & Datasets --------------------
# Raw and processed data (large files)
data/
datasets/
*.csv
!*_labels.csv
*.json
!split_info.json
!*.config.json

# ISIC Dataset specific
ISIC_2019_Training_Input/
ISIC_2019_Training_GroundTruth.csv

# -------------------- Model Checkpoints & Results --------------------
# Model weights and checkpoints
*.pth
*.pt
*.ckpt
*.h5
*.hdf5
*.onnx
*.pb
checkpoints/
results/
experiments/
outputs/
runs/

# WandB logs
wandb/

# TensorBoard logs
tensorboard/
lightning_logs/

# -------------------- Logs & Temporary Files --------------------
*.log
*.tmp
*.temp
*.bak
logs/

# -------------------- Images & Plots (generated) --------------------
# Keep source diagrams, ignore generated
*.png
!docs/*.png
!*_diagram.png
!hld_*.png
!lld_*.png

# -------------------- OS Specific --------------------
# macOS
.DS_Store
.AppleDouble
.LSOverride
._*

# Windows
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/

# Linux
*~

# -------------------- Testing --------------------
.pytest_cache/
.coverage
htmlcov/
.tox/
.nox/
coverage.xml
*.cover
*.coverage
.hypothesis/

# -------------------- mypy / Type Checking --------------------
.mypy_cache/
.dmypy.json
dmypy.json

# -------------------- Misc --------------------
# Version files (auto-generated)
1.1.0

# Secrets / API keys
.env.local
.env.*.local
secrets.yaml
credentials.json

# Large files (Git LFS tracked separately)
*.zip
*.tar
*.tar.gz
*.rar
*.7z

# Profiling
*.prof
*.lprof

# ============================================
# End of .gitignore
# ============================================
